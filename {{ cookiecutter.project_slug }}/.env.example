# Django
DJANGO_SETTINGS_MODULE={{ cookiecutter.project_slug }}.settings.local
DJANGO_SECRET_KEY=change_me_in_production

# Database
POSTGRES_DB={{ cookiecutter.postgresql_db }}
POSTGRES_USER={{ cookiecutter.postgresql_user }}
POSTGRES_PASSWORD={{ cookiecutter.postgresql_password }}
POSTGRES_HOST=db
POSTGRES_PORT=5432

{% if cookiecutter.use_celery == 'y' %}
# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
{% endif %}

# Cache
CACHE_URL=redis://redis:6379/2

{% if cookiecutter.include_oauth2 == 'y' %}
# OAuth2 - Google
GOOGLE_OAUTH2_CLIENT_ID=
GOOGLE_OAUTH2_CLIENT_SECRET=

# OAuth2 - GitHub
GITHUB_OAUTH2_CLIENT_ID=
GITHUB_OAUTH2_CLIENT_SECRET=

# OAuth2 - Facebook
FACEBOOK_OAUTH2_CLIENT_ID=
FACEBOOK_OAUTH2_CLIENT_SECRET=
{% endif %}

{% if cookiecutter.include_sentry == 'y' or 'sentry' in cookiecutter.observability or 'all' in cookiecutter.observability %}
# Sentry
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
{% endif %}
{% if 'datadog' in cookiecutter.observability or 'all' in cookiecutter.observability %}
# Datadog
DD_API_KEY=
DD_APP_KEY=
DD_SERVICE={{ cookiecutter.project_slug }}
DD_ENV=development
DD_VERSION=
DD_TRACE_ENABLED=false
{% endif %}
{% if 'newrelic' in cookiecutter.observability or 'all' in cookiecutter.observability %}
# New Relic
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME={{ cookiecutter.project_slug }}
NEW_RELIC_CONFIG_FILE=newrelic.ini
NEW_RELIC_ENVIRONMENT=development
{% endif %}
{% if 'opentelemetry' in cookiecutter.observability or 'all' in cookiecutter.observability %}
# OpenTelemetry
OTEL_SERVICE_NAME={{ cookiecutter.project_slug }}
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_ENABLED=false
{% endif %}
